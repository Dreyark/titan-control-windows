#define RT_MANIFEST 24

1 ICON "titan_control.ico"
1 RT_MANIFEST "titan_control.manifest"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Titan Control"
      VALUE "ProductName", "Titan Control"
      VALUE "FileVersion", "1.0.1"
      VALUE "ProductVersion", "1.0.1"
      VALUE "OriginalFilename", "titan_control.exe"
      VALUE "LegalCopyright", "MIT License"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
