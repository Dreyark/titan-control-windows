                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">monitor</property>
                    <property name="title">Monitor</property>
                    <property name="icon-name">preferences-system-symbolic</property>
                    <property name="child">
                      <object class="AdwPreferencesPage">
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Menu OSD</property>
                            <child>
                              <object class="AdwSwitchRow" id="osd_lock">
                                <property name="title">Blokada OSD</property>
                                <property name="subtitle">Blokuje przyciski menu na monitorze</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="button_lock">
                                <property name="title">Blokada przycisków skrótów</property>
                                <property name="subtitle">Blokuje przyciski 2 i 3 (Custom 1 / Custom 2)</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="osd_language">
                                <property name="title">Język</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>Chiński (uproszczony)</item>
                                      <item>Angielski</item>
                                      <item>Francuski</item>
                                      <item>Niemiecki</item>
                                      <item>Włoski</item>
                                      <item>Japoński</item>
                                      <item>Koreański</item>
                                      <item>Portugalski</item>
                                      <item>Rosyjski</item>
                                      <item>Hiszpański</item>
                                      <item>Turecki</item>
                                      <item>Chiński (tradycyjny)</item>
                                      <item>Portugalski (Brazylia)</item>
                                      <item>Arabski</item>
                                      <item>Holenderski</item>
                                      <item>Fiński</item>
                                      <item>Grecki</item>
                                      <item>Hindi</item>
                                      <item>Polski</item>
                                      <item>Tajski</item>
                                      <item>Ukraiński</item>
                                      <item>Wietnamski</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Czas wyświetlania (s)</property>
                                <child type="suffix">
                                  <object class="GtkScale">
                                    <property name="hexpand">false</property>
                                    <property name="width-request">340</property>
                                    <property name="valign">3</property>
                                    <property name="draw-value">true</property>
                                    <property name="value-pos">0</property>
                                    <property name="digits">0</property>
                                    <property name="adjustment">adj_osd_time</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwExpanderRow">
                                <property name="title">Położenie i przezroczystość</property>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title">Pozycja pozioma</property>
                                    <child type="suffix">
                                      <object class="GtkScale">
                                        <property name="hexpand">false</property>
                                        <property name="width-request">340</property>
                                        <property name="valign">3</property>
                                        <property name="draw-value">true</property>
                                        <property name="value-pos">0</property>
                                        <property name="digits">0</property>
                                        <property name="adjustment">adj_osd_h</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title">Pozycja pionowa</property>
                                    <child type="suffix">
                                      <object class="GtkScale">
                                        <property name="hexpand">false</property>
                                        <property name="width-request">340</property>
                                        <property name="valign">3</property>
                                        <property name="draw-value">true</property>
                                        <property name="value-pos">0</property>
                                        <property name="digits">0</property>
                                        <property name="adjustment">adj_osd_v</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwActionRow">
                                    <property name="title">Przezroczystość</property>
                                    <child type="suffix">
                                      <object class="GtkScale">
                                        <property name="hexpand">false</property>
                                        <property name="width-request">340</property>
                                        <property name="valign">3</property>
                                        <property name="draw-value">true</property>
                                        <property name="value-pos">0</property>
                                        <property name="digits">0</property>
                                        <property name="adjustment">adj_osd_trans</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Zasilanie</property>
                            <child>
                              <object class="AdwActionRow">
                                <property name="title">Oszczędzanie energii</property>
                                <child type="suffix">
                                  <object class="AdwToggleGroup" id="power_saving">
                                    <property name="valign">3</property>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="label">Off</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="label">Lvl 1</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="label">Lvl 2</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="usb_power_sleep">
                                <property name="title">Zasilanie USB w uśpieniu</property>
                                <property name="subtitle">Porty USB monitora ładują, gdy monitor śpi</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwSwitchRow" id="quick_boot">
                                <property name="title">Quick Boot</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwButtonRow" id="power_off">
                                <property name="title">Wyłącz monitor</property>
                                <property name="start-icon-name">system-shutdown-symbolic</property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Informacje</property>
                            <child>
                              <object class="AdwActionRow" id="info_model">
                                <property name="title">Model</property>
                                <property name="subtitle">—</property>
                                <style>
                                  <class name="property"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwComboRow" id="firmware_package">
                                <property name="title">Wgrany pakiet firmware</property>
                                <property name="subtitle">Monitor nie zgłasza pakietu, wybierz ręcznie. Z pakietem 2025-09-20 DyDs działa razem z Adaptive-Sync</property>
                                <property name="model">
                                  <object class="GtkStringList">
                                    <items>
                                      <item>2024-12-11</item>
                                      <item>2025-09-20</item>
                                    </items>
                                  </object>
                                </property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwActionRow" id="info_usage">
                                <property name="title">Czas pracy</property>
                                <property name="subtitle">—</property>
                                <style>
                                  <class name="property"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title">Przywracanie</property>
                            <property name="description">Każda akcja wymaga potwierdzenia</property>
                            <child>
                              <object class="AdwButtonRow" id="reset_colors">
                                <property name="title">Resetuj kolory</property>
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwButtonRow" id="reset_brightness">
                                <property name="title">Resetuj jasność i kontrast</property>
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="AdwButtonRow" id="reset_factory">
                                <property name="title">Przywróć ustawienia fabryczne</property>
                                <style>
                                  <class name="destructive-action"/>
                                </style>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </property>
        <property name="sidebar">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="decoration-layout"></property>
                <property name="title-widget">
                  <object class="AdwWindowTitle" id="sidebar_title">
                    <property name="title">Titan Control</property>
                    <property name="subtitle"></property>
                  </object>
                </property>
              </object>
            </child>
            <property name="content">
              <object class="GtkStackSidebar" id="sidebar">
                <property name="stack">stack</property>
                <property name="vexpand">true</property>
              </object>
            </property>
            <child type="bottom">
              <object class="GtkDropDown" id="monitor_select">
                <property name="visible">false</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">12</property>
                <property name="tooltip-text">Wybór monitora</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>—</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
  <object class="AdwPreferencesDialog" id="prefs_dialog">
    <property name="title">Preferencje</property>
    <property name="search-enabled">false</property>
    <child>
      <object class="AdwPreferencesPage" id="prefs_page">
        <property name="title">Ogólne</property>
        <property name="icon-name">preferences-system-symbolic</property>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Wygląd</property>
            <child>
              <object class="AdwComboRow" id="pref_language">
                <property name="title">Język aplikacji</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Systemowy</item>
                      <item>English</item>
                      <item>Polski</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="pref_theme">
                <property name="title">Motyw</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Systemowy</item>
                      <item>Jasny</item>
                      <item>Ciemny</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="pref_tray_icon">
                <property name="title">Ikona w zasobniku</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Kolory motywu</item>
                      <item>Jasna</item>
                      <item>Ciemna</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Uruchamianie</property>
            <child>
              <object class="AdwSwitchRow" id="pref_autostart">
                <property name="title">Uruchamiaj z systemem</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="pref_start_minimized">
                <property name="title">Uruchamiaj zminimalizowany</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwPreferencesGroup">
            <property name="title">Zasobnik</property>
            <property name="description">Przytrzymaj klawisz, aby pokazać gwiazdki przy ustawieniach i dodać je do menu w zasobniku (do 5)</property>
            <child>
              <object class="AdwComboRow" id="pref_favorite_modifier">
                <property name="title">Klawisz ulubionych</property>
                <property name="model">
                  <object class="GtkStringList">
                    <items>
                      <item>Ctrl</item>
                      <item>Shift</item>
                      <item>Alt</item>
                      <item>Super</item>
                    </items>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label">Preferencje</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label">O programie</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>